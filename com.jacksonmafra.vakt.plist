<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jacksonmafra.vakt</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/VAKT.app/Contents/MacOS/VAKT</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Relaunch if the process dies or is force-quit. -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardErrorPath</key>
    <string>/tmp/vakt.err.log</string>
</dict>
</plist>
